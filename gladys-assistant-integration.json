{
  "manifest_version": 1,
  "type": "device",
  "name": "Nintendo Parental Controls",
  "description": {
    "en": "Nintendo Switch play time: daily limit, bonus time, current game, alerts and buttons.",
    "fr": "Temps de jeu Nintendo Switch : limite du jour, temps bonus, jeu en cours, alertes et boutons.",
    "de": "Spielzeit der Nintendo Switch: Tageslimit, Bonuszeit, aktuelles Spiel, Hinweise und Tasten.",
    "es": "Tiempo de juego de Nintendo Switch: límite diario, tiempo extra, juego actual, avisos y botones."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-nintendo-parental:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-nintendo-parental/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your Nintendo account",
        "fr": "Connecter votre compte Nintendo",
        "de": "Dein Nintendo-Konto verbinden",
        "es": "Conectar su cuenta Nintendo"
      },
      "description": {
        "en": "Click Connect and sign in with the parent account of the Parental Controls app. Then right-click the red \"Select this person\" button, copy the link address and paste it below. Your password never goes through Gladys.",
        "fr": "Cliquez sur Connecter et identifiez-vous avec le compte parent de l'appli Contrôle parental. Faites ensuite un clic droit sur le bouton rouge « Choisir cette personne », copiez l'adresse du lien et collez-la ci-dessous. Votre mot de passe ne passe jamais par Gladys.",
        "de": "Klicke auf Verbinden und melde dich mit dem Elternkonto der Jugendschutz-App an. Klicke dann mit der rechten Maustaste auf den roten Knopf „Diese Person auswählen“, kopiere die Linkadresse und füge sie unten ein. Dein Passwort geht nie über Gladys.",
        "es": "Haga clic en Conectar e inicie sesión con la cuenta de padre de la aplicación de control parental. Luego haga clic derecho en el botón rojo «Seleccionar a esta persona», copie la dirección del enlace y péguela abajo. Su contraseña nunca pasa por Gladys."
      },
      "links": [
        {
          "url": "https://www.nintendo.com/my/support/switch/parentalcontrols/app/setup.html",
          "label": {
            "en": "Set up the Parental Controls app",
            "fr": "Installer l'appli Contrôle parental",
            "de": "Jugendschutz-App einrichten",
            "es": "Configurar la aplicación de control parental"
          }
        },
        {
          "url": "https://github.com/guim31/gladys-nintendo-parental/blob/main/docs/en.md",
          "label": {
            "en": "Step-by-step guide",
            "fr": "Guide pas à pas",
            "de": "Schritt-für-Schritt-Anleitung",
            "es": "Guía paso a paso"
          }
        }
      ]
    },
    {
      "key": "nintendo_account",
      "type": "account_link",
      "label": {
        "en": "Nintendo account",
        "fr": "Compte Nintendo",
        "de": "Nintendo-Konto",
        "es": "Cuenta Nintendo"
      },
      "description": {
        "en": "Opens the Nintendo sign-in page.",
        "fr": "Ouvre la page de connexion de Nintendo.",
        "de": "Öffnet die Anmeldeseite von Nintendo.",
        "es": "Abre la página de inicio de sesión de Nintendo."
      }
    },
    {
      "key": "redirect_link",
      "type": "secret",
      "label": {
        "en": "Link of \"Select this person\"",
        "fr": "Lien de « Choisir cette personne »",
        "de": "Link von „Diese Person auswählen“",
        "es": "Enlace de «Seleccionar a esta persona»"
      },
      "description": {
        "en": "Starts with npf54789befb391a838://auth. Used once: the integration then keeps its own session.",
        "fr": "Commence par npf54789befb391a838://auth. Utilisé une fois : l'intégration garde ensuite sa propre session.",
        "de": "Beginnt mit npf54789befb391a838://auth. Wird einmal benutzt: danach behält die Integration ihre eigene Sitzung.",
        "es": "Empieza por npf54789befb391a838://auth. Se usa una vez: luego la integración conserva su propia sesión."
      },
      "placeholder": {
        "en": "npf54789befb391a838://auth#…",
        "fr": "npf54789befb391a838://auth#…",
        "de": "npf54789befb391a838://auth#…",
        "es": "npf54789befb391a838://auth#…"
      },
      "required": false
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Nintendo is asked for the play time. The console itself reports every few minutes.",
        "fr": "Fréquence à laquelle Nintendo est interrogé. La console elle-même transmet toutes les quelques minutes.",
        "de": "Wie oft Nintendo gefragt wird. Die Konsole selbst meldet sich alle paar Minuten.",
        "es": "Con qué frecuencia se consulta a Nintendo. La propia consola informa cada pocos minutos."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
